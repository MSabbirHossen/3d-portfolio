# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority

# Firebase Authentication (Server Admin SDK)
FIREBASE_PROJECT_ID=portfolio-admin-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@portfolio-admin-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Client Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleApiKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=portfolio-admin-xxxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=portfolio-admin-xxxxx
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Single Owner UID Authorization
OWNER_FIREBASE_UID=firebase_owner_uid_here

# Session Cookie Encryption Secret (min 32 chars)
SESSION_SECRET=generate_a_random_32_character_secret_here

# Cloudinary Media Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=example_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=example_cloudinary_secret

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
